# Copy to .env and fill only the settings you use. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OpenAI API backend (separate from a ChatGPT subscription).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium

# Codex backend uses `codex login` on the machine running the filter.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_MODEL=your-model

# Daily runner defaults to OpenAI; none opts into the legacy regex filter.
JOB_AGENT_FILTER_PROVIDER=openai
JOB_AGENT_PROMPT_FILE=filters/new_grad_prompt.txt
JOB_AGENT_BATCH_SIZE=20
JOB_AGENT_TIMEOUT=120
# Set JOB_FILTER_FILE only if you want an additional DSL prefilter in agent mode.
# JOB_FILTER_FILE=filters/new_grad.json

# SQL text snapshot. Set an empty value to disable local persistence.
JOB_STATE_FILE=out/state.sql
